# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C++ Build outputs & Binary files
build/
bin/
lib/
*.o
*.so
*.a
*.out
*.exe

# Models & Dynamic Weights (Keep raw specifications only)
